# docker compose (infra/) 와 API가 읽는 값
POSTGRES_PASSWORD=whyuseguide

# ODPT 액세스 토큰 (developer.odpt.org 가입 승인 후 발급). 커밋하지 말 것.
ODPT_TOKEN=

# 호스트 포트 (다른 프로젝트와 겹치면 바꾼다)
# 포트나 비밀번호를 바꾸면 아래 *_URL도 같이 바꾼다: 호스트에서 도는 API·파이프라인·마이그레이션이 읽는다.
DB_PORT=15432
REDIS_PORT=16379
OTP_PORT=18080
API_PORT=8000

# 호스트에서 실행할 때의 접속 주소(기본값과 같다. 위 포트·비밀번호를 바꿨을 때만 고친다)
# DATABASE_URL=postgresql+psycopg://whyuseguide:whyuseguide@localhost:15432/whyuseguide
# REDIS_URL=redis://localhost:16379/0
# OTP_URL=http://localhost:18080
