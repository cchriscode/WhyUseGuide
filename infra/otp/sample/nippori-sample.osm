  <node id="4" lat="35.72640" lon="139.76650" version="1"/>
  <node id="5" lat="35.72900" lon="139.77050" version="1"/>
  <way id="100" version="1">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/><nd ref="4"/>
    <tag k="highway" v="footway"/>
    <tag k="name" v="谷中ぎんざ方面"/>
